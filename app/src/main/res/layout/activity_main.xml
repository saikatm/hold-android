<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:text="Ready"
            android:textColor="@color/white"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hold a volume key to launch."
            android:textColor="@color/secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOn"
                style="@style/Widget.Hold.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn on"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOff"
                style="@style/Widget.Hold.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn off"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Volume up" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pagerUp"
            android:layout_width="match_parent"
            android:layout_height="270dp" />

        <LinearLayout
            android:id="@+id/dotsUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/divider" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Volume down" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pagerDown"
            android:layout_width="match_parent"
            android:layout_height="270dp" />

        <LinearLayout
            android:id="@+id/dotsDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/divider" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hold time (ms)" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/holdGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h300"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="300"
                android:textColor="@color/chip_text"
                app:backgroundTint="@color/chip_bg"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h400"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="400"
                android:textColor="@color/chip_text"
                app:backgroundTint="@color/chip_bg"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h500"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="500"
                android:textColor="@color/chip_text"
                app:backgroundTint="@color/chip_bg"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h650"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="650"
                android:textColor="@color/chip_text"
                app:backgroundTint="@color/chip_bg"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/h800"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="800"
                android:textColor="@color/chip_text"
                app:backgroundTint="@color/chip_bg"
                app:strokeColor="@color/divider" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/divider" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVibration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Vibration"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swScreen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Screen on only"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSetup"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="Setup checklist" />

        <TextView
            android:id="@+id/version"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hold" />
    </LinearLayout>
</ScrollView>
